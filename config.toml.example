# CTC Server Configuration Example
# Copy to config.toml and modify as needed.
# All values shown are defaults.

[server]
# Host address to bind to
host = "0.0.0.0"
# Port number to listen on
port = 3000

[serial]
# Default serial port path (can be overridden via CLI argument)
default_port = "/dev/ttyAMA4"
# Baud rate (typically 9600 for CTC systems)
baud_rate = 9600
# Data bits (5, 6, 7, or 8)
data_bits = 8
# Parity: "none", "even", or "odd"
parity = "even"
# Stop bits (1 or 2)
stop_bits = 1
# Flow control: "none", "software", or "hardware"
flow_control = "hardware"
# Serial operation timeout in seconds
timeout_secs = 1

[modbus]
# Modbus slave ID (typically 1 for CTC systems)
slave_id = 1
# Channel buffer size for actor message queue
channel_buffer_size = 24
# Timeout for individual Modbus read/write operations (seconds)
operation_timeout_secs = 5
# Maximum retry attempts for failed operations
max_retries = 2
# Initial delay before first retry (milliseconds)
initial_retry_delay_ms = 100
# Exponential backoff multiplier for retry delays
backoff_multiplier = 2.0
# Consecutive failures before logging critical warning
max_consecutive_failures = 5
# HTTP request timeout waiting for actor response (seconds)
# Should be higher than operation_timeout_secs to allow for retries
request_timeout_secs = 10

[temperature_validation]
# Minimum allowed room temperature setpoint (C)
min = 5.0
# Maximum allowed room temperature setpoint (C)
max = 30.0

[gpio]
# Enable GPIO-based SmartGrid control via relay board
# When enabled, uses GPIO pins to control K24/K25 terminals directly
# When disabled, SmartGrid endpoints return 503 Service Unavailable
enabled = true
# GPIO pin number for K24 (Smart A) terminal
gpio_k24 = 20
# GPIO pin number for K25 (Smart B) terminal
gpio_k25 = 21
# True if relay board uses active-low logic (LOW = relay ON)
# Set to false for active-high relay modules (HIGH = relay ON)
active_low = false

[tibber]
# Enable Tibber API integration (set token via CTC_TIBBER_API_TOKEN)
enabled = false

[price]
# Enable electricity price tracking
enabled = true
# Swedish bidding zone: SE1, SE2, SE3 (default), SE4
zone = "SE3"
# How often to fetch new spot prices (minutes)
fetch_interval_mins = 15

[heatpump_stats]
# Enable cycle / accumulator tracking
enabled = true
# Polling interval (seconds)
poll_interval_secs = 10
# Optional path to a JSON file used to persist accumulators and history across restarts.
# Comment out (or leave unset) to disable persistence — useful for dev/test runs.
# persist_path = "./heatpump_stats.json"

[smartgrid]
# When the user manually blocks the heater (e.g. via the dashboard powersave badge),
# the server scans price data for the cheapest contiguous run of
# `auto_resume_min_duration_minutes` inside `auto_resume_window_hours` and
# schedules an automatic flip back to Normal at the start of that run.
auto_resume_enabled = true
auto_resume_window_hours = 12
auto_resume_min_duration_minutes = 30

[homey]
# Homey REST integration for slaving the Cirkulationspump (smart plug) to
# SmartGrid mode: ON for Normal/LowPrice/Overcapacity, OFF for Blocking.
# A reconciliation poller corrects drift every `poll_interval_secs`.
enabled = false
# Homey Pro LAN URL (no trailing slash).
url = "http://192.168.10.10"
# Personal Access Token. Set via CTC_HOMEY_TOKEN env var — do NOT commit.
# Required scopes: homey.device.control, homey.device.readonly.
# token = ""
# Device id of the smart plug acting as the pump switch.
pump_device_id = "864d0cbf-eb44-450f-a37a-cbf14a1b705f"
# Reconciliation poll interval (seconds). 0 disables polling (push-only —
# drift from Homey restarts or manual plug toggles will NOT be corrected).
poll_interval_secs = 60